# Hivework custom
hive.config.json
/state/

# Claude / local
/.claude/

# Smoke fixtures (local only)
/smoke/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# Secrets — Hivework's real secrets live OUTSIDE the repo (~/.hivework/.env or
# $HIVE_ENV_FILE; run setup.bat / setup.sh to create it). These patterns are
# defence-in-depth so a stray local .env can never be committed.
.env
.env.*
*.secrets.json

# Hive runtime artifacts
hive_ledger.db*
hive_workdir/
/.apply_backups/
# decompose debug dumps written to the run cwd
/decompose_prompt_last.txt
/decompose_raw_last.txt

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
